{
  "name": "carecadas-estudos",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma editorial Carecadas",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
